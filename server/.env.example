# Google Gemini API key (FREE tier works) — get yours at:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_key_here

# Gemini model to use. Free-tier options:
#   gemini-2.0-flash-lite      → 30 RPM, 1500/day  (most generous quota)
#   gemini-2.0-flash           → 15 RPM, 1500/day
#   gemini-2.5-flash           → 10 RPM, 500/day   (best quality)
GEMINI_MODEL=gemini-2.0-flash-lite

# Port the API listens on
PORT=3001

# Comma-separated list of allowed frontend origins for CORS.
# In dev the default is http://localhost:5173.
# In production set this to your deployed frontend URL.
CORS_ORIGINS=http://localhost:5173

# Optional shared-secret token for the expensive endpoints (/api/review,
# /api/review/stream, /api/upload). When set, clients must send it as the
# "x-api-token" header — this is the only control that blocks non-browser
# clients (curl/scripts) from burning your Gemini quota. Set the SAME value as
# the client's VITE_API_TOKEN. Leave UNSET for an open public demo.
API_ACCESS_TOKEN=

# Optional Redis connection string. Set this to share rate-limit counters across
# multiple server instances (Vercel functions / Railway replicas). Without it,
# each instance counts independently (fine for a single instance).
# Example: redis://default:password@host:6379
REDIS_URL=
