# Google Gemini API key (FREE tier works) — get yours at:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_key_here

# Gemini model to use. Free-tier options (best → lowest rate limit):
#   gemini-2.0-flash-lite      → 30 RPM, 1500/day  (default, most generous)
#   gemini-2.0-flash           → 15 RPM, 1500/day
#   gemini-1.5-flash-8b        → 15 RPM, 1500/day
#   gemini-2.5-flash-preview-05-20 → 10 RPM, 500/day (best quality)
GEMINI_MODEL=gemini-2.0-flash-lite

# Port the API listens on
PORT=3001

# Comma-separated list of allowed frontend origins for CORS.
# In dev the default is http://localhost:5173.
# In production set this to your deployed frontend URL.
CORS_ORIGINS=http://localhost:5173
